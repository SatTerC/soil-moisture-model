{% extends "_base/docstring/attributes.html.jinja" %}

{#- Attributes in `spacy` style, with the whole docstring and the default value.

Used for the parameter and constant tables on the science page, which opt in
with `docstring_section_style: spacy`; the API reference pages keep the `list`
style. The layout follows the `spacy` overrides in satterc's
`docs_tools/templates`: name on the left; description, type and default on the
right. Two departures from the stock block: the stock attributes summary keeps
only the first line of each field's docstring, so the full docstring is read
off the member instead; and the stock block has no default, so one is added,
reusing the `doc-param-default` class that floats it right.
-#}

{% import "language.html.jinja" as lang with context %}

{% block spacy_style scoped %}
  <table>
    <thead>
      <tr>
        <th><span class="doc-section-title">{{ (section.title or lang.t("ATTRIBUTE")).rstrip(":").upper() }}</span></th>
        <th><span>{{ lang.t("DESCRIPTION") }}</span></th>
      </tr>
    </thead>
    <tbody>
      {% for attribute in section.value %}
        {% set member = obj.members.get(attribute.name) %}
        {% set description = member.docstring.value if member and member.docstring else attribute.description %}
        <tr class="doc-section-item">
          <td><code><autoref identifier="{{ obj.path }}.{{ attribute.name }}" optional hover>{{ attribute.name }}</autoref></code></td>
          <td class="doc-attribute-details">
            <div class="doc-md-description">
              {{ description|convert_markdown(heading_level, html_id, autoref_hook=autoref_hook) }}
            </div>
            <p>
              {% if attribute.annotation %}
                <span class="doc-attribute-annotation">
                  <b>{{ lang.t("TYPE:") }}</b>
                  {% with expression = attribute.annotation %}
                    <code>{% include "expression.html.jinja" with context %}</code>
                  {% endwith %}
                </span>
              {% endif %}
              {% if attribute.value is not none %}
                <span class="doc-param-default">
                  <b>{{ lang.t("DEFAULT:") }}</b>
                  {% with expression = attribute.value %}
                    <code>{% include "expression.html.jinja" with context %}</code>
                  {% endwith %}
                </span>
              {% endif %}
            </p>
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endblock spacy_style %}
